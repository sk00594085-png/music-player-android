<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title + Enable switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/equalizer"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_eq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <!-- Preset spinner -->
    <Spinner
        android:id="@+id/spinner_presets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <!-- Band 0 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tv_band0"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelSmall" />

        <SeekBar
            android:id="@+id/seek_band0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Band 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tv_band1"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelSmall" />

        <SeekBar
            android:id="@+id/seek_band1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Band 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tv_band2"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelSmall" />

        <SeekBar
            android:id="@+id/seek_band2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Band 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tv_band3"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelSmall" />

        <SeekBar
            android:id="@+id/seek_band3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Band 4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tv_band4"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelSmall" />

        <SeekBar
            android:id="@+id/seek_band4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

    </LinearLayout>

</LinearLayout>
